# Montecristo — plantilla de variables de entorno
#
# Copia este archivo a `.env` (git la ignora) o define las variables en el panel
# del hosting. TODO es opcional: sin ninguna variable el casino arranca con el
# backend de archivo JSON en ./data y con las funciones administrativas apagadas.
#
# Convención de flags: `on`/`true`/`1`/`yes` activan; cualquier otra cosa apaga.
# Los valores marcados [SECRETO] NO se versionan y deben generarse por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─────────────────────────────── Núcleo ───────────────────────────────
# Puerto HTTP (Render lo inyecta solo).
PORT=3000
# production activa el endurecimiento: CORS de Socket.IO cerrado a orígenes
# conocidos y desactivación total de los ganchos de mazo fijo de tests.
NODE_ENV=production
# Zona horaria del casino (temporadas, bono diario, calendario del Estadio).
CASINO_TIME_ZONE=America/Mexico_City
# JSON por línea en los logs (LOG_JSON=off los deja en texto plano).
LOG_JSON=on
# Milisegundos de gracia para guardar durante un SIGTERM (Render reinicia).
SHUTDOWN_GRACE_MS=10000

# ──────────────────────────── Persistencia ────────────────────────────
# Con DATABASE_URL se usa Postgres (Neon y similares) para todo el estado.
# Sin ella, cada store usa su archivo JSON local.
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
# La verificación TLS del certificado está ACTIVA por defecto. Solo si el
# proveedor usa una CA propia sin bundle disponible:
# PGSSL_REJECT_UNAUTHORIZED=false
#
# Rutas de los stores de archivo (por defecto ./data/*):
# PROFILE_STORE_PATH=/var/data/profiles.json
# FOOTBALL_STORE_PATH=/var/data/football.json
# COMMUNITY_STORE_PATH=/var/data/community.json
# LOBBY_TOURNAMENT_STORE_PATH=/var/data/lobby-tournaments.json
# DEVICE_LINK_STORE_PATH=/var/data/device-links.json
# FORTUNE_STATE_PATH=/var/data/fortune-ledger.json
# LOTERIA_STATE_PATH=/var/data/loteria.json
# PROMOTION_MEDIA_DIR=/var/data/promotion-media
# Tope de perfiles NUEVOS en memoria (0 = sin límite). Frena scripts que crean
# identidades al azar; los perfiles existentes nunca se bloquean.
# MAX_PROFILES=50000

# ───────────────────────────── Cuentas ───────────────────────────────
# Sesiones seguras por cookie. Requiere DATABASE_URL y APP_ORIGIN.
# ACCOUNT_SESSIONS_ENABLED=on
# APP_ORIGIN=https://tu-dominio.example      # HTTPS, sin ruta ni query
# Nº de proxies de confianza delante de la app (Cloudflare + Render = 2).
# TRUST_PROXY_HOPS=2
# [SECRETO] ≥32 bytes base64. Firma cookies y códigos de recuperación.
# SESSION_PEPPER=
# Orígenes extra permitidos para el handshake de Socket.IO (separados por comas).
# ALLOWED_ORIGINS=https://preview.example

# ────────────────────── Administración y MFA ─────────────────────────
# Panel /admin. Fail-closed: si falta cualquier secreto, el proceso no arranca.
# ADMIN_FEATURE_ENABLED=on
# [SECRETO] exactamente 32 bytes base64. Cifra los secretos TOTP.
# MFA_ENCRYPTION_KEY=
# [SECRETO] ≥32 bytes base64. Hashea IPs en la auditoría.
# AUDIT_IP_PEPPER=
# ADMIN_MAINTENANCE_MODE=on

# ────────────────────────────── Estadio ──────────────────────────────
# FOOTBALL_ENABLED=on
# FOOTBALL_QUINIELA_ENABLED=on
# FOOTBALL_LOBBY_CAPACITY=200
# FOOTBALL_MATCH_CAPACITY=40
# FOOTBALL_BET_DELAY_MS=4000
# FOOTBALL_SIM_SECONDS_PER_MINUTE=90
# FOOTBALL_SIM_SOFTENER=
# FOOTBALL_SIM_WEIGHT=
# FOOTBALL_SIM_WINDOW_MS=
# FOOTBALL_HALFTIME_MS=
# FOOTBALL_ODDS_SWEEP_MS=
# FOOTBALL_SWEEP_MS=
# FOOTBALL_STAKE_MIN_FRAC=
# FOOTBALL_STAKE_MAX_FRAC=
# FOOTBALL_MAX_STAKE=
# FOOTBALL_MIN_MARGIN_INVARIANT=0.02
# Con DATABASE_URL, concesión de único escritor del motor (bloquea el escalado
# horizontal a propósito; ver README «single-instance»).
# FOOTBALL_WRITER_WAIT_MS=180000
# Arranque con presupuesto: el proceso escucha en segundos y termina de recuperar
# los partidos vencidos por tandas (visible en /healthz como football.catchUp).
# FOOTBALL_BOOT_DEFER=on
# Tope de CPU del arranque antes de soltar el control. 0 = no recuperar en línea.
# FOOTBALL_BOOT_BUDGET_MS=2500

# ─────────────────────── Juegos y funciones ──────────────────────────
# LOTERIA_ENABLED=on
# LOTERIA_CALL_INTERVAL_MS=
# LOTERIA_REGISTRATION_MS=
# LOTERIA_BREAK_MS=
# FORTUNE_ENABLED=on
# CARD_GACHA_ENABLED=on
# PASSPORT_ENABLED=on
# REPORT_GUEST_ENABLED=on

# ─────────────────────────── Bots / mesas ────────────────────────────
# AUTO_BOTS=on
# AUTO_BOT_DIFFICULTY=
# BOT_SPEED_FACTOR=
# BOT_ONLY_ROOM_TTL_MS=
# HOST_INACTIVITY_MS=
# HOST_INACTIVITY_SWEEP_MS=
# RECONNECT_GRACE_MS=
# SEASON_RESET_MAX_DEFERRALS=

# ⚠️ SOLO TESTS — nunca en producción ────────────────────────────────
# Los ganchos de mazo fijo requieren ALLOW_TEST_DECK_HOOKS=on Y NODE_ENV≠production;
# aun así, el servidor avisa por log si ve TEST_*_DECK en un despliegue normal.
# ALLOW_TEST_DECK_HOOKS=on
# TEST_BLACKJACK_DECK=["AS","KH", ...]
# TEST_POKER_DECK=["AS","KH", ...]
# BOT_FORCE_DECISION_ERROR=1
# DEMO_NOW=2026-10-12T17:00:00Z
